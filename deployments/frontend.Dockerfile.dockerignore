# Default: ignore everything
**

# Keep monorepo files needed by frontend image build
!package.json
!bun.lock

!backend/
!backend/package.json

!frontend/
!frontend/**

!deployments/
!deployments/frontend.nginx.conf.template

# Exclude frontend noise
frontend/node_modules
frontend/dist
frontend/.turbo
frontend/.cache
frontend/.DS_Store

# Exclude repo noise
.git
.github
.vscode
**/.DS_Store